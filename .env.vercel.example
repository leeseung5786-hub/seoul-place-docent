# Copy to .env.local for native Next.js development.
# In Vercel, enter these as server-side Environment Variables (never NEXT_PUBLIC_*).
JUSO_API_KEY=
BUILDING_API_KEY=
KAKAO_REST_API_KEY=
KAKAO_JAVASCRIPT_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
NATIONAL_ARCHIVES_API_KEY=
SEOUL_PHOTOS_API_KEY=
PERMIT_API_KEY=
CLOSED_BUILDING_API_KEY=
VWORLD_API_KEY=
SEOUL_OPEN_DATA_API_KEY=

# Existing Cloudflare D1 database; token needs D1 access on this account.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=

# Existing R2 bucket; use bucket-scoped S3 credentials.
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Admin requests use x-archive-admin. Sites identity headers are not trusted here.
ARCHIVE_ADMIN_TOKEN=

# Separate public MCP endpoint shown on the existing homepage (no credentials).
MCP_PUBLIC_URL=
# Optional exact browser origins. Server-to-server requests omit Origin.
MCP_ALLOWED_ORIGINS=
